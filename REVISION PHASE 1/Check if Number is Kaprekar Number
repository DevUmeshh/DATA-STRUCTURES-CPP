#include <iostream>
using namespace std;

bool isKaprekar(int n) {
    long long sq = 1LL * n * n;
    int digits = 0, temp = n;

    while (temp > 0) {
        digits++;
        temp /= 10;
    }

    long long divisor = 1;
    for (int i = 0; i < digits; i++)
        divisor *= 10;

    long long right = sq % divisor;
    long long left = sq / divisor;

    return (left + right == n);
}
