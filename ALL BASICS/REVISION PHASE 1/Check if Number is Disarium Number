#include <cmath>

bool isDisarium(int n) {
    int temp = n, digits = 0;

    while (temp > 0) {
        digits++;
        temp /= 10;
    }

    temp = n;
    int sum = 0;
    while (temp > 0) {
        int d = temp % 10;
        sum += pow(d, digits);
        digits--;
        temp /= 10;
    }

    return sum == n;
}
