#include <iostream>
using namespace std;

int countDivBy3(int n) {
    int count = 0;
    while (n > 0) {
        int d = n % 10;
        if (d % 3 == 0)
            count++;
        n /= 10;
    }
    return count;
}

int main() {
    int n;
    cin >> n;
    cout << countDivBy3(n);
    return 0;
}
