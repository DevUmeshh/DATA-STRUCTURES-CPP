#include <iostream>
using namespace std;

int sumProperDivisors(int n) {
    if (n <= 1) return 0;
    int sum = 1;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            sum += i;
            if (i != n / i)
                sum += n / i;
        }
    }
    return sum;
}

int main() {
    int n;
    cin >> n;
    cout << sumProperDivisors(n);
    return 0;
}
