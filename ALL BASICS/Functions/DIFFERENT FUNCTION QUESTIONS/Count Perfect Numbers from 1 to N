#include <iostream>
using namespace std;

bool isPerfect(int n) {
    if (n <= 1) return false;
    int sum = 1;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            sum += i;
            if (i != n / i)
                sum += n / i;
        }
    }
    return sum == n;
}

int countPerfect(int n) {
    int count = 0;
    for (int i = 2; i <= n; i++) {
        if (isPerfect(i))
            count++;
    }
    return count;
}

int main() {
    int n;
    cin >> n;
    cout << countPerfect(n);
    return 0;
}
