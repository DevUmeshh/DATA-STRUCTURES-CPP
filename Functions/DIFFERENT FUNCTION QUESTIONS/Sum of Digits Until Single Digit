#include <iostream>
using namespace std;

int digitalRoot(int n) {
    while (n >= 10) {
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        n = sum;
    }
    return n;
}

int main() {
    int n;
    cin >> n;
    cout << digitalRoot(n);
    return 0;
}
