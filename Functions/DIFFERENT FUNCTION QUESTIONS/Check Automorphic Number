#include <iostream>
using namespace std;

bool isAutomorphic(int n) {
    int square = n * n;
    int temp = n;

    while (temp > 0) {
        if (temp % 10 != square % 10)
            return false;
        temp /= 10;
        square /= 10;
    }
    return true;
}

int main() {
    int n;
    cin >> n;
    if (isAutomorphic(n))
        cout << "YES";
    else
        cout << "NO";
    return 0;
}
